{
  "multipart": [
    {
      "when": {
        "flag_group": "false",
        "is_top": "false",
        "overlay_only": "false"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag_pole"
      }
    },
    {
      "when": {
        "flag_group": "false",
        "is_top": "true",
        "overlay_only": "false"
      },
      "apply": {
        "model": "vs_sails:block/pole_top"
      }
    },
    {
      "when": {
        "flag_group": "true",
        "overlay_only": "false"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag/rotate_blue_wind_flag"
      }
    }
  ]
}
