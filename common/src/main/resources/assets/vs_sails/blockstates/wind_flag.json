{
  "multipart": [
    {
      "when": {
        "flag_group": "false",
        "is_top": "false",
        "overlay_only": "false"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag_pole"
      }
    },
    {
      "when": {
        "flag_group": "false",
        "is_top": "true",
        "overlay_only": "false"
      },
      "apply": {
        "model": "vs_sails:block/pole_top"
      }
    },
    {
      "when": {
        "flag_group": "true",
        "overlay_only": "false"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag_rotate"
      }
    },
    {
      "when": {
        "overlay_only": "true",
        "pattern": "1"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag/rotate_overlay_skull"
      }
    },
    {
      "when": {
        "overlay_only": "true",
        "pattern": "2"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag/rotate_overlay_creeper"
      }
    },
    {
      "when": {
        "overlay_only": "true",
        "pattern": "3"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag/rotate_overlay_flower"
      }
    },
    {
      "when": {
        "overlay_only": "true",
        "pattern": "4"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag/rotate_overlay_mojang"
      }
    },
    {
      "when": {
        "overlay_only": "true",
        "pattern": "5"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag/rotate_overlay_globe"
      }
    },
    {
      "when": {
        "overlay_only": "true",
        "pattern": "6"
      },
      "apply": {
        "model": "vs_sails:block/wind_flag/rotate_overlay_piglin"
      }
    }
  ]
}
